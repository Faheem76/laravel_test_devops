# Installed inside the image instead — keeps 380M+ out of the build context
# and avoids baking in macOS-native binaries that can't run on Linux.
node_modules
vendor

# Secrets and local-only config
.env
.env.*
!.env.example

# Built assets — regenerated by `npm run build` in the build stage
public/build
public/hot
public/storage

# Local database
database/*.sqlite
database/*.sqlite-journal

# Runtime state
storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*

# VCS, tooling, editors
.git
.github
.gitignore
.gitattributes
.idea
.vscode
.DS_Store
.phpunit.result.cache
.phpstan.cache

# Not needed at runtime
Dockerfile
.dockerignore
compose.yaml
docker-compose.yml
README.md
tests
phpunit.xml
phpstan.neon
pint.json
eslint.config.js
.prettierrc
.prettierignore
.editorconfig
